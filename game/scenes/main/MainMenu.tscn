[node name="Desc" type="RichTextLabel" parent="AboutDialog/Panel/ScrollContainer/ContentVBox"]
layout_mode = 2
size_flags_horizontal = 3
fit_content = true
bbcode_enabled = true
text = "[color=#8C3518][b]MEKATILILI WA MENZA: A KENYAN HISTORICAL ADVENTURE[/b][/color]

[color=#211C18]This game honors the courage and leadership of [b]Mekatilili wa Menza[/b], the prophetess and freedom fighter who led the Agiriama people during the historic 1913–1914 anti-colonial resistance in coastal Kenya.[/color]

[color=#8C3518][b]CORE PRINCIPLES & CULTURAL ROOTS[/b][/color]

[color=#211C18]• [b]Authentic Coastal History:[/b] Grounded in verified Giriama historical narratives, oral accounts, and sacred traditions.[/color]

[color=#211C18]• [b]Sacred Kaya Preservation:[/b] Revering the ancient Mijikenda Kaya shrines, sacred oaths (Mukushe & Kifudu), and ancestral forests.[/color]

[color=#211C18]• [b]Community Solidarity:[/b] Gameplay centers on collective unity, mutual aid, and peaceful defiance against forced plantation labor.[/color]

[color=#211C18]• [b]Accessible To All Generations:[/b] Designed with high-contrast typography, voiceover narration, and intuitive controls for elderly and youth players alike.[/color]"

