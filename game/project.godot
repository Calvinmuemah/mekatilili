; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited by hand.

config_version=5

[application]

config/name="Mekatilili wa Menza"
config/description="A Kenyan Historical Adventure game about Mekatilili wa Menza"
run/main_scene="res://scenes/main/SplashScreen.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/bg_color=Color(0.231373, 0.141176, 0.086275, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

GamePalette="*res://scripts/core/GamePalette.gd"
GameManager="*res://autoload/GameManager.gd"
SaveManager="*res://autoload/SaveManager.gd"
SceneManager="*res://autoload/SceneManager.gd"
AudioManager="*res://autoload/AudioManager.gd"
StoryManager="*res://autoload/StoryManager.gd"
DialogueManager="*res://autoload/DialogueManager.gd"
QuestManager="*res://autoload/QuestManager.gd"
ApiClient="*res://autoload/ApiClient.gd"
NetworkManager="*res://autoload/NetworkManager.gd"
AuthManager="*res://autoload/AuthManager.gd"
SyncManager="*res://autoload/SyncManager.gd"
ContentSyncManager="*res://autoload/ContentSyncManager.gd"
TelemetryManager="*res://autoload/TelemetryManager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=0
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

